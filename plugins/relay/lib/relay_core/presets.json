{
  "codex": {
    "type": "cli",
    "bin": "codex",
    "args": ["exec", "--skip-git-repo-check", "--sandbox", "{sandbox}", "--output-last-message", "{out}", "{model_args}", "{prompt}"],
    "model_args": ["-m", "{model}"],
    "mode_vars": {"read": {"sandbox": "read-only"}, "write": {"sandbox": "workspace-write"}, "edit": {"sandbox": "workspace-write"}},
    "output": "file",
    "account_env": "CODEX_HOME",
    "data": "unverified",
    "cost": "subscription",
    "kinds": ["read", "write", "edit"],
    "note": "OpenAI Codex CLI. Separate accounts: set env CODEX_HOME to a different folder per account and run `CODEX_HOME=... codex login` once."
  },
  "claude": {
    "type": "cli",
    "bin": "claude",
    "args": ["-p", "{prompt}", "--output-format", "text", "{mode_args}", "{model_args}"],
    "model_args": ["--model", "{model}"],
    "mode_args": {
      "read": ["--allowedTools", "Read,Grep,Glob"],
      "write": ["--allowedTools", "Read,Grep,Glob,Write,Edit", "--permission-mode", "acceptEdits"],
      "edit": ["--allowedTools", "Read,Grep,Glob,Write,Edit", "--permission-mode", "acceptEdits"]
    },
    "output": "stdout",
    "account_env": "CLAUDE_CONFIG_DIR",
    "data": "unverified",
    "cost": "subscription",
    "kinds": ["read", "write", "edit"],
    "note": "A second Claude account (e.g. company Team/Enterprise). Set env CLAUDE_CONFIG_DIR to a separate folder and log in there once. Pointless with the same account as your main session."
  },
  "gemini": {
    "type": "cli",
    "bin": "gemini",
    "args": ["-p", "{prompt}", "{mode_args}", "{model_args}"],
    "model_args": ["-m", "{model}"],
    "mode_args": {
      "read": ["--approval-mode", "default"],
      "write": ["--approval-mode", "auto_edit"],
      "edit": ["--approval-mode", "auto_edit"]
    },
    "output": "stdout",
    "account_env": "GEMINI_CLI_HOME",
    "data": "unverified",
    "cost": "subscription",
    "kinds": ["read", "write", "edit"],
    "experimental": true,
    "note": "Gemini CLI (Code Assist Standard/Enterprise or API key). Flags vary by version: run `relay doctor --probe` after adding."
  },
  "cli": {
    "type": "cli",
    "bin": "",
    "args": ["{prompt}"],
    "output": "stdout",
    "data": "unverified",
    "cost": "subscription",
    "kinds": ["read", "write", "edit"],
    "note": "Any agent CLI. Placeholders: {prompt} {model} {out} plus mode_vars; {model_args} and {mode_args} splice lists."
  },
  "ollama-local": {
    "type": "api",
    "base_url": "http://localhost:11434/v1",
    "auth": "none",
    "model": "",
    "data": "local",
    "cost": "free",
    "kinds": ["read", "write", "edit"],
    "note": "Local model via Ollama. Never leaves your machine. Pick a model you have pulled."
  },
  "ollama-cloud": {
    "type": "api",
    "base_url": "http://localhost:11434/v1",
    "auth": "none",
    "model": "deepseek-v4-flash:cloud",
    "data": "unverified",
    "cost": "free",
    "kinds": ["read", "write", "edit"],
    "note": "Ollama Cloud through your local Ollama daemon (run `ollama signin`). Free tier is light usage."
  },
  "deepseek": {
    "type": "api",
    "base_url": "https://api.deepseek.com/v1",
    "auth": "bearer",
    "key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat",
    "data": "may-train",
    "cost": "cheap",
    "kinds": ["read", "write", "edit"],
    "note": "DeepSeek API. Very cheap; data is processed by DeepSeek in China and may be used to improve services. Public mode only by default."
  },
  "openrouter": {
    "type": "api",
    "base_url": "https://openrouter.ai/api/v1",
    "auth": "bearer",
    "key_env": "OPENROUTER_API_KEY",
    "model": "",
    "data": "may-train",
    "cost": "free",
    "kinds": ["read", "write", "edit"],
    "note": "OpenRouter. Use a ':free' model for zero cost (rate-limited; free providers may log prompts)."
  },
  "openai": {
    "type": "api",
    "base_url": "https://api.openai.com/v1",
    "auth": "bearer",
    "key_env": "OPENAI_API_KEY",
    "model": "",
    "data": "unverified",
    "cost": "paid",
    "kinds": ["read", "write", "edit"],
    "note": "OpenAI API (pay per token)."
  },
  "azure-openai": {
    "type": "api",
    "base_url": "",
    "auth": "api-key",
    "key_env": "AZURE_OPENAI_API_KEY",
    "model": "",
    "data": "unverified",
    "cost": "paid",
    "kinds": ["read", "write", "edit"],
    "note": "Azure OpenAI v1 endpoint: https://<resource>.openai.azure.com/openai/v1 ; model = your deployment name."
  },
  "openai-compatible": {
    "type": "api",
    "base_url": "",
    "auth": "bearer",
    "key_env": "",
    "model": "",
    "data": "unverified",
    "cost": "paid",
    "kinds": ["read", "write", "edit"],
    "note": "Any OpenAI-compatible endpoint (vLLM, LM Studio, LiteLLM, a company gateway)."
  }
}
